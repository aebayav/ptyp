# PTYP OCR servisi — ortam değişkenleri (FastAPI + Ollama + Indra OCR)
# Kopyalayıp düzenleyin: cp ocr-service/.env.example ocr-service/.env
# Not: app.py ortam değişkenlerini doğrudan okur; .env yüklemek için
# systemd biriminde EnvironmentFile=/home/turguz/ptyp/ocr-service/.env kullanın
# ya da komut satırında verin.

# Ollama sunucusu (görsel model sunucusu)
OLLAMA_URL=http://127.0.0.1:11434

# Kullanılacak görsel model (deploy/Modelfile.ptyp-ai — Qwen-VL tabanlı)
VISION_MODEL=ptyp-ai

# VLM okuma güven eşiği (0-1): altındaki sonuçlar "zayıf" sayılır ve yeniden okunur
CONF_THRESHOLD=0.85

# Ollama çağrısı deneme sayısı ve zaman aşımı (sn)
OLLAMA_ATTEMPTS=2
OLLAMA_TIMEOUT=240

# Aynı anda Ollama'ya gönderilecek bant isteği sayısı.
# DİKKAT: Ollama OLLAMA_NUM_PARALLEL=1 ile çalışıyorsa 1'den büyük MAYMAYI yok
# — paralel istekler llama-server'ı düşürebilir.
OCR_CONCURRENCY=1

# PDF render ölçeği (taban ölçek; düşük çözünürlükte otomatik yükselir)
PDF_SCALE=2.5

# Düşük çözünürlüklü görüntülerin OCR öncesi büyütüleceği hedef uzun kenar (px)
MIN_OCR_LONG_EDGE=3300

# Indra OCR (ana motor): binary yolu (boşsa venv/PATH'ten bulunur), çekirdek sayısı,
# "yeterli satır" eşiği (altında VLM yedeğe düşülür), açma/kapama
INDRA_BIN=
INDRA_CORES=6
INDRA_MIN_ROWS=2
INDRA_ENABLED=1

# Koordinat aykırı-değer eşiği (metre): bu mesafeyi aşan düzeltmeler reddedilir
OUTLIER_M=25000

# Zayıf bantları ikili (binarize) görüntüyle yeniden okuma (1=açık)
RETRY_WEAK=1
