[Unit]
Description=PTYP OCR Servisi (Indra OCR + Ollama PaddleOCR-VL-1.6 fallback)
After=network.target

[Service]
User=turguz
WorkingDirectory=/home/turguz/ptyp/ocr-service
Environment=OLLAMA_URL=http://127.0.0.1:11434
Environment=VISION_MODEL=paddleocr-vl
Environment=CONF_THRESHOLD=0.85
Environment=OLLAMA_ATTEMPTS=2
Environment=OLLAMA_NUM_THREADS=8
Environment=OLLAMA_KEEP_ALIVE=30m
Environment=INDRA_CORES=6
ExecStart=/home/turguz/ptyp/ocr-service/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8787
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
