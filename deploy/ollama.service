[Unit]
Description=Ollama Service (PTYP 10 vCPU / 10 GB RAM optimize yapılandırması)
After=network-online.target

[Service]
ExecStart=/usr/local/bin/ollama serve
User=ollama
Group=ollama
Restart=always
RestartSec=3
# 10 GB RAM / CPU-only optimizasyonları:
# - OLLAMA_MMAP=1: bellek eşlemeli yükleme (OOM riskini azaltır)
# - OLLAMA_KV_CACHE_TYPE=q8_0: f16'ya göre KV cache RAM'ini yarıya indirir
# - OLLAMA_NUM_PARALLEL=1 & MAX_LOADED_MODELS=1: tek model + tek slot ile minimum RAM
# - OLLAMA_KEEP_ALIVE=30m: çalışma boyunca sıcak kalır, boşta RAM'i serbest bırakır
Environment=OLLAMA_MMAP=1
Environment=OLLAMA_NUM_GPU=0
Environment=OLLAMA_KV_CACHE_TYPE=q8_0
Environment=OLLAMA_FLASH_ATTENTION=1
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_KEEP_ALIVE=30m

[Install]
WantedBy=multi-user.target
